env/
.env
__pycache__/
.pytest_cache/
# ⚠️ **不带路径前缀**，故意如此。原先写的是 `ros2_ws/build/` 这种锚定写法，
# 于是「在仓库根目录误跑一次 colcon」就会凭空造出一套平行的 build/install/log，
# 而且**不被忽略**、直接以 `??` 出现在 git status 里（实测踩过一次：
# 从根目录 `colcon build --packages-select ...` 会递归找到 ros2_ws/src 下的包，
# 编到根 install/ 里；而现场 source 的是 ros2_ws/install/setup.bash，
# 于是「刚编译完」和「跑起来还是老代码」同时成立 —— 最难查的一类假象）。
# colcon 的工作目录本身就是约定：构建产物一律不入库，不管它出现在哪一层。
build/
install/
log/
*.pyc

# 临时产物工作区：`make_click_labeler.py` 生成的单文件点选页面落在这里
# （内嵌一整帧顶视画面，1.6 MB 量级，一条命令就能重生成，没有入库的理由）。
.scratch/

# P0: 附件隔离解压区（不入库，见 docs/ATTACHMENT_MANIFEST.md）
docs/reference/

# demo_pipeline.py 的独立数据集输出（几何与 block_dataset/ 不同，见 D30）
block_dataset_demo/

# YOLO 权重：属**构建产物**而非源码，默认不入库（历史里已有一批被删但仍在
# history 中的 .pt blob，见 RESTRUCTURE_PLAN 的 Q7，不再往上加）。
# 需要随仓库分发时用 `git add -f` 显式覆盖。
# detector_node 会按 $YOLO_MODEL_DIR → CWD 逐级向上 → 包内 models/ 的顺序查找，
# 找不到就明确报错，**不会**联网下载 COCO 权重冒充（见 D6/D24）。
ros2_ws/src/yolo_detector/models/*.pt
