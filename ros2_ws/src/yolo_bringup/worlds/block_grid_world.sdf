<?xml version="1.0" ?>
<!--
方块仿真环境
用于 YOLO 视觉模型训练数据采集
方块数: 9
-->
<sdf version="1.11">
  <world name="block_grid_world">

    <!-- 物理 -->
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <bullet>
        <solver><type>sequential_impulse</type></solver>
      </bullet>
    </physics>

    <!-- 传感器系统 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    </plugin>

    <!-- 用户交互 -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- 场景信息广播 -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- 光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1.0</diffuse>
      <specular>0.5 0.5 0.5 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3</ambient>
            <diffuse>0.5 0.5 0.5</diffuse>
            <specular>0.1 0.1 0.1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 桌子 -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0.0 0.0 0 0 0</pose>

      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.03</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_fl">
        <pose>0.35 0.25 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1.0</ambient>
            <diffuse>0.5 0.3 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_fr">
        <pose>0.35 -0.25 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1.0</ambient>
            <diffuse>0.5 0.3 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_bl">
        <pose>-0.35 0.25 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1.0</ambient>
            <diffuse>0.5 0.3 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_br">
        <pose>-0.35 -0.25 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1.0</ambient>
            <diffuse>0.5 0.3 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RGBD 相机 -->
    <model name="camera_model">
      <static>true</static>
      <pose>0.5 0.0 1.5 0.0 1.5708 0.0</pose>

      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1.0</ambient>
            <diffuse>0.2 0.2 0.2 1.0</diffuse>
          </material>
        </visual>

        <sensor name="rgb_camera" type="camera">
          <topic>/camera/color/image_raw</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.0470</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>

        <sensor name="depth_camera" type="depth_camera">
          <topic>/camera/depth/image_raw</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.0470</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- 方块：9 个（8 正方体 + 1 圆柱）-->

    <model name="block_0">
      <static>false</static>
      <pose>0.3400 -0.1200 0.7850 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material>
            <ambient>0.680 0.120 0.120 1.0</ambient>
            <diffuse>0.680 0.120 0.120 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_1">
      <static>false</static>
      <pose>0.5000 -0.1200 0.7850 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material>
            <ambient>0.850 0.150 0.150 1.0</ambient>
            <diffuse>0.850 0.150 0.150 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_2">
      <static>false</static>
      <pose>0.6600 -0.1200 0.7850 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
