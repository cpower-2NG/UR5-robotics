        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material>
            <ambient>1.000 0.180 0.180 1.0</ambient>
            <diffuse>1.000 0.180 0.180 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_3">
      <static>false</static>
      <pose>0.3400 0.0000 0.7850 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
