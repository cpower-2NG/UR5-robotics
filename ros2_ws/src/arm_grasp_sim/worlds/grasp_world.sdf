<?xml version="1.0"?>
<sdf version="1.9">
  <world name="grasp_world">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- ── Lighting ──────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 2 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- ── Ground plane ──────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4</ambient><diffuse>0.6 0.6 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Table (80×60cm, desktop at z=0.41) ───────────────── -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0.0 0.0 0 0 0</pose>
      <link name="table_top">
        <pose>0 0 0.395 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.03</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_fl">
        <pose>0.35 0.25 0.198 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.15</ambient><diffuse>0.5 0.3 0.15</diffuse></material>
        </visual>
      </link>
      <link name="leg_fr">
        <pose>0.35 -0.25 0.198 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.15</ambient><diffuse>0.5 0.3 0.15</diffuse></material>
        </visual>
      </link>
      <link name="leg_bl">
        <pose>-0.35 0.25 0.198 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.15</ambient><diffuse>0.5 0.3 0.15</diffuse></material>
        </visual>
      </link>
      <link name="leg_br">
        <pose>-0.35 -0.25 0.198 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.395</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.15</ambient><diffuse>0.5 0.3 0.15</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── RGBD Camera (640×480, 1.145m height) ──────────────── -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.5 0.0 1.145 0 1.57 0</pose>
      <link name="camera_link">
        <sensor name="color_camera" type="camera">
          <update_rate>15</update_rate>
          <topic>rgbd_camera/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
        <sensor name="depth_camera" type="depth_camera">
          <update_rate>15</update_rate>
          <topic>rgbd_camera/depth_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- ── 9 Blocks (3×3 grid, classmate's scene) ───────────── -->
    <!-- Desktop surface at z=0.41, blocks at z=0.43 (bottom on surface) -->

    <model name="block_r0_c0">
      <static>false</static>
      <pose>0.3400 -0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1.0</ambient><diffuse>0.85 0.15 0.15 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r0_c1">
      <static>false</static>
      <pose>0.5000 -0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.68 0.12 0.12 1.0</ambient><diffuse>0.68 0.12 0.12 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r0_c2">
      <static>false</static>
      <pose>0.6600 -0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.18 0.18 1.00 1.0</ambient><diffuse>0.18 0.18 1.00 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r1_c0">
      <static>false</static>
      <pose>0.3400 0.0000 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>1.00 0.18 0.18 1.0</ambient><diffuse>1.00 0.18 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r1_c1">
      <static>false</static>
      <pose>0.5000 0.0000 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0200</radius><length>0.0400</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0200</radius><length>0.0400</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.85 1.0</ambient><diffuse>0.15 0.15 0.85 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r1_c2">
      <static>false</static>
      <pose>0.6600 0.0000 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.18 0.96 0.18 1.0</ambient><diffuse>0.18 0.96 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r2_c0">
      <static>false</static>
      <pose>0.3400 0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.15 0.15 0.85 1.0</ambient><diffuse>0.15 0.15 0.85 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r2_c1">
      <static>false</static>
      <pose>0.5000 0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.15 0.80 0.15 1.0</ambient><diffuse>0.15 0.80 0.15 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_r2_c2">
      <static>false</static>
      <pose>0.6600 0.1200 0.4300 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry>
          <material><ambient>0.12 0.64 0.12 1.0</ambient><diffuse>0.12 0.64 0.12 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Robot pedestal ───────────────────────────────────── -->
    <model name="pedestal">
      <static>true</static>
      <pose>-0.1 0.0 0.40 0 0 0</pose>
      <link name="pedestal_link">
        <collision name="pedestal_collision">
          <geometry><box><size>0.15 0.15 0.80</size></box></geometry>
        </collision>
        <visual name="pedestal_visual">
          <geometry><box><size>0.15 0.15 0.80</size></box></geometry>
          <material><ambient>0.3 0.3 0.3</ambient><diffuse>0.5 0.5 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
  </world>
</sdf>
