<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5">

  <xacro:arg name="name" default="ur5"/>
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- ── AG-95 简化两指：相邻/永久碰撞对 ─────────────────────
       固定连接的 link 之间不做碰撞检查；两指之间的开合区域必须允许
       「夹住工件」，但两指本体互不相撞。 -->
  <disable_collisions link1="tool0" link2="ag95_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="ag95_base_link" reason="Never"/>
  <disable_collisions link1="ag95_base_link" link2="ag95_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="ag95_base_link" link2="ag95_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="ag95_left_finger_link" link2="ag95_right_finger_link" reason="Never"/>

  <!-- ── 腕部相机（固定连接）─────────────────────────────────── -->
  <disable_collisions link1="tool0" link2="wrist_camera_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="wrist_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="ag95_base_link" reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="ag95_left_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="ag95_right_finger_link" reason="Never"/>

</robot>
